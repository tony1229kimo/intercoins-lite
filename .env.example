# ═══════════════════════════════════════════════════════════════
#  洲遊幣 Lite — 環境變數
#  ⚠️ 真實金鑰只填在 Zeabur 環境變數，絕不 commit 進 repo（踩雷 T09）
# ═══════════════════════════════════════════════════════════════

# ── 前端（會送到瀏覽器，非機密）────────────────────────────────
# LINE LIFF App ID，格式 <channel_id>-<liff_id>
# ⚠️ 必須是「高雄洲際 LINE Login channel 1656533531」底下【新建的第二個 LIFF app】，
#    不要沿用味蕾旅遊地圖的 1656533531-U5OvwB62 —— 一個 LIFF 只能有一個 Endpoint URL，
#    改掉會讓現役的味蕾地圖當場失效。
LIFF_ID=

# ── 後端（機密，只填 Zeabur）──────────────────────────────────
# LIFF id_token 驗證用。= LIFF_ID 的數字前綴。高雄洲際 = 1656533531
LINE_CHANNEL_ID=1656533531

# 高雄洲際 LINE 官方帳號 Messaging API long-lived channel access token。
# 用途：(1) 加好友檢查 GET /v2/bot/profile/:userId  (2) 中獎後推播 Flex 兌換券
# 取得：LINE Developers → Messaging API → Channel access token (long-lived) → Issue
# 👉 味蕾旅遊地圖的 Zeabur 專案已經有同一把，可直接沿用
LINE_MESSAGING_ACCESS_TOKEN_KH=

# 加好友引導連結（未加好友 gate 的按鈕）
LINE_ADD_FRIEND_URL=https://lin.ee/uKzkNI9

# 後台 API 保護（查庫存、改機率、匯出中獎名單）
ADMIN_TOKEN=

# Postgres 連線字串。Zeabur 綁 PostgreSQL 服務後會自動注入 DATABASE_URL
DATABASE_URL=

# 對外網址（Flex 訊息裡的 claim 連結要用絕對網址）
PUBLIC_BASE_URL=https://intercoins.ictaiwan.net

PORT=8080
NODE_ENV=production
